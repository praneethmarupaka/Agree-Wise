{
  "manifest_version": 3,
  "name": "AgreeWise",
  "version": "0.1.0",
  "description": "AI-powered Terms & Conditions and Privacy Policy analyzer.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AgreeWise",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["badge.js", "content.js", "implicit.js"],
      "run_at": "document_idle"
    }
  ]
}
